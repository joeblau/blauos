+    get_target_property(_blauos_libdyld_libs libdyld LINK_LIBRARIES)
+    foreach(_runtime_target libsystem_kernel_static libplatform_static
+            pthread_static libmalloc_static libc_static libc_internal_static)
+        list(REMOVE_ITEM _blauos_libdyld_libs "$<TARGET_FILE:${_runtime_target}>")
+    endforeach()
+    list(REMOVE_ITEM _blauos_libdyld_libs
+        "${CMAKE_BINARY_DIR}/src/Libraries/libSystem/libsystem_kernel/syscalls.a"
+        "$<TARGET_FILE:XPC_libxpc_static>" "$<TARGET_FILE:XPC_launchd_mig_static>")
+    set_property(TARGET libdyld PROPERTY LINK_LIBRARIES "${_blauos_libdyld_libs}")
+    target_link_libraries(libdyld PRIVATE "${BLAUOS_SYSTEM_INTERFACE}")
