+target_include_directories(libdyld BEFORE PRIVATE ${BLAUOS_CXX_HEADERS} ${CMAKE_BINARY_DIR}/src/Libraries/libSystem/libsystem_kernel/public_include)
+target_compile_options(libdyld PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-nostdinc++>)
+
+# Avoid stock SDK libSystem declarations selecting imports before source archives.
+get_target_property(_blauos_libdyld_link_options libdyld LINK_OPTIONS)
+list(REMOVE_ITEM _blauos_libdyld_link_options -Wl,-framework,System)
+set_target_properties(libdyld PROPERTIES LINK_OPTIONS "${_blauos_libdyld_link_options}")
+target_sources(libdyld PRIVATE ${BLAUOS_STACK_PROBE})
+
+# Resolve the real C++ ABI unwinder inside the standalone source dylib.
+add_dependencies(libdyld libunwind_static_build)
+target_link_libraries(libdyld PRIVATE $<TARGET_FILE:libunwind_static>)
