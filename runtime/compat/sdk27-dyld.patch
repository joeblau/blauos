+# Standalone source implementation exports only loader, blocks and C++ ABI APIs.
+# Keep embedded libc/syscall storage private so libSystem uses its own state.
+target_link_options(libdyld PRIVATE -Wl,-exported_symbols_list,${BLAUOS_LIBDYLD_EXPORTS})
