    "sandbox_init returning successful enforcement without installing a policy",
    "xpc_create_from_plist aborting as unimplemented",
    "dyld dispatch_once_f used from multiple threads without synchronization",
    "dyld _Block_copy or _Block_release paths that abort"
  ]
}
