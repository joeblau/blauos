+#if defined(XNU_LOADER_VIRTUALBUDDY)
+    VB_JUMP_MARK 'K'
+#endif
     mov sp, x11
     mov x0, x10     /* boot_args_phys */
     br x9
 
+#if defined(XNU_LOADER_VIRTUALBUDDY)
+/* Pre-kernel exception evidence. XNU installs its own VBAR immediately. */
+.balign 2048
+vb_exception_vectors:
+.rept 16
+    b vb_exception_handler
+.balign 128
+.endr
+vb_exception_handler:
+    msr daifset, #0xf
+    mrs x10, tpidr_el1
+    VB_JUMP_MARK '!'
+    mrs x19, esr_el1
+    bl vb_exception_hex
+    VB_JUMP_MARK ':'
+    mrs x19, elr_el1
+    bl vb_exception_hex
+    VB_JUMP_MARK ':'
+    mrs x19, far_el1
+    bl vb_exception_hex
+    VB_JUMP_MARK '!'
+1:  wfe
+    b 1b
+vb_exception_hex:
+    mov x20, #16
+2:
+    lsr x18, x19, #60
+    lsl x19, x19, #4
+    cmp w18, #10
+    b.lt 3f
+    add w14, w18, #(0x41-10)
+    b 4f
+3:  add w14, w18, #0x30
+4:  VB_JUMP_BYTE
+    subs x20, x20, #1
+    b.ne 2b
+    ret
+#endif
