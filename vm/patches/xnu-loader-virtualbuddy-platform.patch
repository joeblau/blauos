+#if defined(XNU_LOADER_VIRTUALBUDDY)
+    VB_JUMP_MARK 'J'
+    msr tpidr_el1, x10
+    adrp x12, vb_exception_vectors
+    add x12, x12, :lo12:vb_exception_vectors
