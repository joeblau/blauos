diff --git a/src/vb_platform.c b/src/vb_platform.c
new file mode 100644
index 0000000..d7b10ac
--- /dev/null
+++ b/src/vb_platform.c
@@ -0,0 +1,159 @@
+#include "vb_platform.h"
+#include "app.h"
+#include "console.h"
+
+VBPlatform gVB;
+typedef struct __attribute__((packed)) { CHAR8 sig[4]; UINT32 len; UINT8 rev, sum; CHAR8 rest[26]; } Header;
+static UINT32 u32(CONST VOID *p) { UINT32 v; CopyMem(&v,p,4); return v; }
+static UINT64 u64(CONST VOID *p) { UINT64 v; CopyMem(&v,p,8); return v; }
+static BOOLEAN checksum(CONST VOID *p, UINTN n) { UINT8 sum=0; for (UINTN i=0;i<n;i++) sum+=((CONST UINT8 *)p)[i];return sum==0; }
+static BOOLEAN readable(CONST VOID *p, UINTN size) {
+  UINT64 start=(UINT64)(UINTN)p;
+  return start>=gVB.ram_base && start<=gVB.ram_end && size<=gVB.ram_end-start;
+}
+static BOOLEAN table(Header *h) {
+  return readable(h,36) && h->len>=36 && h->len<=1048576 &&
+         readable(h,h->len) && checksum(h,h->len);
+}
+
+EFI_STATUS vb_discover(AppContext *ctx) {
+  SetMem(&gVB,sizeof(gVB),0);
+  UINTN size=0,key=0,stride=0;UINT32 version=0;EFI_MEMORY_DESCRIPTOR *map=NULL;
+  EFI_STATUS s=uefi_call_wrapper(ctx->bs->GetMemoryMap,5,&size,map,&key,&stride,&version);
+  if (s!=EFI_BUFFER_TOO_SMALL || stride<sizeof(*map) || stride>65536 || size>1048576-stride*8) return EFI_COMPROMISED_DATA;
+  size+=stride*8;UINTN capacity=size;
+  s=app_alloc_pool(ctx,size,(VOID **)&map);if(EFI_ERROR(s))return s;
+  s=uefi_call_wrapper(ctx->bs->GetMemoryMap,5,&size,map,&key,&stride,&version);
+  if(EFI_ERROR(s)||size>capacity||stride<sizeof(*map)||stride>size||size%stride) {app_free_pool(ctx,map);return EFI_COMPROMISED_DATA;}
+  gVB.ram_base=~(UINT64)0;
+  for(UINTN i=0;i<size/stride;i++) {
+    EFI_MEMORY_DESCRIPTOR *d=(VOID *)((UINT8 *)map+i*stride);
+    if(d->Type<1||d->Type>10||d->Type==8||d->NumberOfPages>(~(UINT64)0>>12))continue;
+    UINT64 bytes=d->NumberOfPages<<12;if(d->PhysicalStart>~(UINT64)0-bytes)continue;
+    if(d->PhysicalStart<gVB.ram_base)gVB.ram_base=d->PhysicalStart;
+    if(d->PhysicalStart+bytes>gVB.ram_end)gVB.ram_end=d->PhysicalStart+bytes;
+  }
+  app_free_pool(ctx,map);
+  if(gVB.ram_base>=gVB.ram_end||gVB.ram_end>0x100000000ULL)return EFI_UNSUPPORTED;
