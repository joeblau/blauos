+/* IONetworkStack deliberately waits for a userspace interface namer before
+ * attaching an IOKit network interface to BSD. A headless static-IP baseline
+ * has no configd InterfaceNamer, so request its genuine register-all operation
+ * through the same privileged user client before polling BSD interfaces.
+ * IONetworkStack.h defines command 2 and the key below; register-all assigns
+ * available unit numbers and calls attachToDataLinkLayer on published devices.
+ */
+static int
+register_network_interfaces(void)
+{
+    CFMutableDictionaryRef properties;
+    CFNumberRef number;
+    io_service_t stack;
+    io_connect_t connection = MACH_PORT_NULL;
+    kern_return_t result;
+    int command = 2; /* kIONetworkStackRegisterInterfaceAll */
+
+    stack = IOServiceGetMatchingService(kIOMasterPortDefault,
+                                       IOServiceMatching("IONetworkStack"));
+    if (stack == MACH_PORT_NULL)
+        return -1;
+
+    result = IOServiceOpen(stack, mach_task_self(), 0, &connection);
+    IOObjectRelease(stack);
+    if (result != KERN_SUCCESS) {
+        pd_log("IONetworkStack IOServiceOpen failed: 0x%x", result);
+        return -1;
+    }
+
+    properties = CFDictionaryCreateMutable(NULL, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    number = CFNumberCreate(NULL, kCFNumberIntType, &command);
+    if (properties == NULL || number == NULL) {
+        if (properties != NULL) CFRelease(properties);
+        if (number != NULL) CFRelease(number);
+        IOServiceClose(connection);
+        errno = ENOMEM;
+        return -1;
+    }
+    CFDictionarySetValue(properties, CFSTR("IONetworkStackUserCommand"), number);
+    CFRelease(number);
+    result = IOConnectSetCFProperties(connection, properties);
+    CFRelease(properties);
+    IOServiceClose(connection);
+    if (result != KERN_SUCCESS) {
+        pd_log("IONetworkStack interface registration failed: 0x%x", result);
+        return -1;
+    }
+    return 0;
+}
