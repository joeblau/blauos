diff --git a/src/Kernel/xnu/osfmk/arm64/start.s b/src/Kernel/xnu/osfmk/arm64/start.s
index e6ccfa6..584ac2e 100644
--- a/src/Kernel/xnu/osfmk/arm64/start.s
+++ b/src/Kernel/xnu/osfmk/arm64/start.s
@@ -81,6 +81,41 @@
  * everywhere it is used below. Bisects the window between the "E0" mark at
  * start_first_cpu and the "M0" mark before the SCTLR_EL1 write. */
 .macro PD_MARK ch
+#if defined(QEMUVIRT)
+	/* Explicit BlauOS EFI profile: bounded pre-MMU virtio TX checkpoint.
+	 * Boot args allocation is one EFI page; private extension at +0x800.
+	 * x9-x11 are dead at these checkpoint sites. */
+	ldr w9, [x20, BA_MACHINE_TYPE]
+	movz w10, #0x4c41
+	movk w10, #0x5642, lsl #16
+	cmp w9, w10
+	b.ne 9f
+	mrs x9, sctlr_el1
+	tbnz x9, #0, 9f
+	ldr x9, [x20, #0x800]
+	cbz x9, 9f
+	mov w11, #\ch
+	strb w11, [x9, #0x300]
+	dsb oshst
+	ldrh w11, [x9, #0x102]
+	add w11, w11, #1
+	strh w11, [x9, #0x102]
+	dsb oshst
+	ldr x10, [x20, #0x808]
+	mov w11, #1
+	strh w11, [x10]
+	movz w10, #0x10, lsl #16
+8:
+	dsb oshld
+	ldrh w11, [x9, #0x202]
+	ldrh w9, [x9, #0x102]
+	cmp w11, w9
+	b.eq 9f
+	ldr x9, [x20, #0x800]
+	subs w10, w10, #1
+	b.ne 8b
+9:
+#endif
 #if defined(BCM2837)
 	movz	x9, #0x3F20, lsl #16
 	movk	x9, #0x1000
@@ -555,8 +590,12 @@ start_cpu:
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
 
+	mov x20, x0
+	PD_MARK 'E'
+
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
+	PD_MARK 'L'
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
 
 #if defined(BCM2837)
