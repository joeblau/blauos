+#if defined(XNU_LOADER_EFI_DIAGNOSTICS_ONLY)
+#include "fileio.h"
+
+static EFI_FILE_PROTOCOL *diagnostic_file;
+static UINTN diagnostic_bytes;
+#define DIAGNOSTIC_LOG_LIMIT 65536u
+
+VOID diagnostic_log_init(EFI_HANDLE image) {
+  EFI_LOADED_IMAGE *loaded = NULL;
+  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL *fs = NULL;
+  EFI_FILE_PROTOCOL *root = NULL;
+  EFI_STATUS status;
+  diagnostic_file = NULL;
+  diagnostic_bytes = 0;
+  Print(L"EFI diagnostics: opening trace file\r\n");
+  status = uefi_call_wrapper(BS->HandleProtocol, 3, image, &LoadedImageProtocol, (VOID **)&loaded);
+  if (EFI_ERROR(status)) return;
+  status = uefi_call_wrapper(BS->HandleProtocol, 3, loaded->DeviceHandle,
+                            &gEfiSimpleFileSystemProtocolGuid, (VOID **)&fs);
+  if (EFI_ERROR(status)) return;
+  status = uefi_call_wrapper(fs->OpenVolume, 2, fs, &root);
+  if (EFI_ERROR(status)) return;
+  status = file_open(root, L"\\EFI\\BOOT\\blauos-efi.txt",
+                     EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE | EFI_FILE_MODE_CREATE,
+                     0, &diagnostic_file);
+  uefi_call_wrapper(root->Close, 1, root);
+  if (EFI_ERROR(status)) { diagnostic_file = NULL; return; }
+  status = file_get_size(diagnostic_file, &diagnostic_bytes);
+  if (!EFI_ERROR(status) && diagnostic_bytes <= DIAGNOSTIC_LOG_LIMIT)
+    status = uefi_call_wrapper(diagnostic_file->SetPosition, 2, diagnostic_file,
+                              (UINT64)diagnostic_bytes);
+  if (EFI_ERROR(status) || diagnostic_bytes > DIAGNOSTIC_LOG_LIMIT) {
+    uefi_call_wrapper(diagnostic_file->Close, 1, diagnostic_file);
+    diagnostic_file = NULL;
+  }
+}
+
+VOID diagnostic_log_close(VOID) {
+  if (diagnostic_file) {
+    uefi_call_wrapper(diagnostic_file->Close, 1, diagnostic_file);
+    diagnostic_file = NULL;
+  }
+}
+
+static VOID diagnostic_append(CONST CHAR16 *text) {
+  if (!diagnostic_file) return;
+  UINTN length = 0;
+  while (length < 512 && text[length] != 0) length++;
+  UINTN bytes = length * sizeof(CHAR16);
+  if (bytes > DIAGNOSTIC_LOG_LIMIT - diagnostic_bytes) return;
+  UINTN written = bytes;
+  EFI_STATUS status = uefi_call_wrapper(diagnostic_file->Write, 3,
+                                        diagnostic_file, &written, (VOID *)text);
+  if (!EFI_ERROR(status) && written <= bytes) {
+    diagnostic_bytes += written;
+    status = uefi_call_wrapper(diagnostic_file->Flush, 1, diagnostic_file);
+  }
+  if (EFI_ERROR(status) || written != bytes) {
+    uefi_call_wrapper(diagnostic_file->Close, 1, diagnostic_file);
+    diagnostic_file = NULL;
+  }
+}
+#endif
