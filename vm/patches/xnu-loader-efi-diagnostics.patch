+#if defined(XNU_LOADER_EFI_DIAGNOSTICS_ONLY)
+static VOID diagnostic_memory_map(AppContext *ctx) {
+  UINTN size = 0, key = 0, stride = 0;
+  UINT32 version = 0;
+  EFI_MEMORY_DESCRIPTOR *map = NULL;
+  EFI_STATUS status = uefi_call_wrapper(ctx->bs->GetMemoryMap, 5,
+      &size, map, &key, &stride, &version);
+  if (status != EFI_BUFFER_TOO_SMALL || stride < sizeof(*map) ||
+      stride > 65536 || size > 1048576 - stride * 8) {
+    log_error(L"EFI diagnostic: rejected memory-map query %r\r\n", status);
+    return;
+  }
+  size += stride * 8;
+  status = app_alloc_pool(ctx, size, (VOID **)&map);
+  if (EFI_ERROR(status)) {
+    log_error(L"EFI diagnostic: memory-map allocation %r\r\n", status);
+    return;
+  }
+  UINTN capacity = size;
+  status = uefi_call_wrapper(ctx->bs->GetMemoryMap, 5,
+      &size, map, &key, &stride, &version);
+  if (!EFI_ERROR(status) && size <= capacity && stride >= sizeof(*map) &&
+      stride <= size && size % stride == 0) {
+    UINT64 largest_start = 0, largest_bytes = 0;
+    UINTN count = size / stride;
+    for (UINTN i = 0; i < count; i++) {
+      EFI_MEMORY_DESCRIPTOR *d = (VOID *)((UINT8 *)map + i * stride);
+      if (d->Type == EfiConventionalMemory && d->NumberOfPages <= (~(UINT64)0 >> 12)) {
+        UINT64 bytes = d->NumberOfPages << 12;
+        if (bytes > largest_bytes && d->PhysicalStart <= ~(UINT64)0 - bytes) {
+          largest_start = d->PhysicalStart;
+          largest_bytes = bytes;
+        }
+      }
+    }
+    log_info(L"EFI memory descriptors=%lu stride=%lu version=%u\r\n", count, stride, version);
+    log_info(L"Largest conventional range: 0x%lx - 0x%lx\r\n",
+             largest_start, largest_start + largest_bytes);
+    log_info(L"QEMU profile expects RAM at 0x40000000; UART MMIO disabled\r\n");
+  } else {
+    log_error(L"EFI diagnostic: memory-map read rejected %r\r\n", status);
+  }
+  app_free_pool(ctx, map);
+}
