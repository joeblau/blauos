diff --git a/src/Kernel/Extensions/IOGraphicsFamily/CMakeLists.txt b/src/Kernel/Extensions/IOGraphicsFamily/CMakeLists.txt
index 351eaf3..50706d9 100644
--- a/src/Kernel/Extensions/IOGraphicsFamily/CMakeLists.txt
+++ b/src/Kernel/Extensions/IOGraphicsFamily/CMakeLists.txt
@@ -42,3 +42,9 @@ target_compile_definitions(IOGraphicsFamily.kext PRIVATE
     DEBG_CATEGORIES_BUILD=0x1ffull)
 set_property(TARGET IOGraphicsFamily.kext PROPERTY CXX_STANDARD 14)
 install(TARGETS IOGraphicsFamily.kext DESTINATION System/Library/Extensions COMPONENT BaseSystem)
+
+# Optional generic-EFI text console; no compressed boot logo dependency.
+option(PUREDARWIN_VIRTUALBUDDY "Build the experimental generic EFI VM console" OFF)
+if(PUREDARWIN_VIRTUALBUDDY)
+    target_compile_definitions(IOGraphicsFamily.kext PRIVATE BLAUOS_VIRTUALBUDDY=1)
+endif()
diff --git a/src/Kernel/Extensions/IOGraphicsFamily/IOFramebuffer.cpp b/src/Kernel/Extensions/IOGraphicsFamily/IOFramebuffer.cpp
index 05bc2aa..1cef1e6 100644
--- a/src/Kernel/Extensions/IOGraphicsFamily/IOFramebuffer.cpp
+++ b/src/Kernel/Extensions/IOGraphicsFamily/IOFramebuffer.cpp
@@ -2436,7 +2436,13 @@ static void IOFramebufferBootInitFB(IOVirtualAddress frameBuffer,
 		if (!logoData) logo = 0;
 		else
 		{
+#if defined(BLAUOS_VIRTUALBUDDY)
+            /* This headless VM profile uses a text console and solid backdrop.
+             * The private compressed-logo codec is not a build dependency. */
+            unpackedSize = 0;
+#else
 			unpackedSize = lzvn_decode(logoData, lw * lh, src, srcSize);
+#endif
 			if (unpackedSize != (lw * lh)) logo = 0;
 		}
 	}
@@ -15316,3 +15322,12 @@ OSMetaClassDefineReservedUnused(IOFramebuffer, 28);
 OSMetaClassDefineReservedUnused(IOFramebuffer, 29);
 OSMetaClassDefineReservedUnused(IOFramebuffer, 30);
 OSMetaClassDefineReservedUnused(IOFramebuffer, 31);
+
+#if defined(BLAUOS_VIRTUALBUDDY)
+/* This declared virtual method has no implementation in the published source.
+ * Report unsupported diagnostics explicitly for the optional VM console. */
+IOReturn IOFramebuffer::diagnoseReport(void *, void *, void *, void *)
+{
+    return kIOReturnUnsupported;
+}
+#endif
