+/* Optional input queue (queue 0) prepared by the loader's console-input
+ * patch; the six-word form of blauos,virtio-console carries it. One posted
+ * 256-byte device-writable buffer is drained and reposted per character. */
+static volatile uint8_t *vb_rx_ring;
+static volatile uint16_t *vb_rx_notify;
+static uint64_t vb_rx_ring_phys;
+static uint16_t vb_rx_consumed;
+static uint16_t vb_rx_pos;
+static uint16_t vb_rx_len;
+static bool vb_rx_failed;
 static void vb_console_init(void) { }
 static int vb_console_ready(void) { return 1; }
-static int vb_console_rx_ready(void) { return 0; }
-static int vb_console_rx(void) { return -1; }
+static void vb_rx_repost(void) {
+	*(volatile uint64_t *)(vb_rx_ring+0)=vb_rx_ring_phys+0x300;
+	*(volatile uint32_t *)(vb_rx_ring+8)=0x100;
+	*(volatile uint16_t *)(vb_rx_ring+12)=2; /* VIRTQ_DESC_F_WRITE */
+	*(volatile uint16_t *)(vb_rx_ring+14)=0;
+	uint16_t idx=*(volatile uint16_t *)(vb_rx_ring+0x102);
+	*(volatile uint16_t *)(vb_rx_ring+0x104+2*(idx%8))=0;
+	__asm__ volatile("dsb oshst":::"memory");
+	*(volatile uint16_t *)(vb_rx_ring+0x102)=idx+1;
+	__asm__ volatile("dsb oshst":::"memory");
+	*vb_rx_notify=0;
+}
+static int vb_console_rx_ready(void) {
+	if (vb_rx_pos<vb_rx_len) return 1;
+	if (!vb_rx_ring || vb_rx_failed) return 0;
+	__asm__ volatile("dsb oshld":::"memory");
+	if (*(volatile uint16_t *)(vb_rx_ring+0x202)==vb_rx_consumed) return 0;
+	volatile uint8_t *elem=vb_rx_ring+0x204+8*(vb_rx_consumed%8);
+	uint32_t id=*(volatile uint32_t *)elem;
+	uint32_t len=*(volatile uint32_t *)(elem+4);
+	vb_rx_consumed++;
+	if (id!=0 || len>0x100) { vb_rx_failed=true; return 0; }
+	vb_rx_len=(uint16_t)len;
+	vb_rx_pos=0;
+	return vb_rx_len>0;
+}
+static int vb_console_rx(void) {
+	if (!vb_console_rx_ready()) return -1;
+	int c=vb_rx_ring[0x300+vb_rx_pos++];
+	if (vb_rx_pos>=vb_rx_len) { vb_rx_len=0; vb_rx_repost(); }
+	return c;
+}
 static void vb_console_tx(int c) {
 	if (!vb_console_ring || vb_console_failed) return;
 	vb_console_ring[0x300]=(uint8_t)c;
@@ -907,7 +947,7 @@ serial_init(void)
