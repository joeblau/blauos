+#if defined(PUREDARWIN_QEMU_PSCI_HVC) && defined(__arm64__)
+/*
+ * This opt-in build profile is for QEMU virt with virtualization=false.
+ * QEMU provides PSCI through HVC in that configuration. The loader's
+ * qemuvirt-io marker keeps this hook off Raspberry Pi and Apple platforms;
+ * the marker alone does not select a PSCI conduit on arbitrary hardware.
+ */
+static bool
+pd_platform_is_qemuvirt(void)
+{
+	IORegistryEntry *armio = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+	if (armio == NULL) return false;
+	OSData *kind = OSDynamicCast(OSData, armio->getProperty("device_type"));
+	static const char expected[] = "qemuvirt-io";
+	bool matches = kind != NULL && kind->getLength() == sizeof(expected) &&
+	    memcmp(kind->getBytesNoCopy(), expected, sizeof(expected)) == 0;
+	armio->release();
+	return matches;
+}
+
+int
+PDArmPlatformExpert::haltRestart(unsigned int type)
+{
+	if (!fQemuVirtPSCI || (type != kPEHaltCPU &&
+	    type != kPEUPSDelayHaltCPU && type != kPERestartCPU)) {
+		return super::haltRestart(type);
+	}
+
+	/* Preserve IODTPlatformExpert's NVRAM synchronization before poweroff. */
+	super::haltRestart(kPEPanicSync);
+	IOLog("PDArmPlatformExpert: QEMU PSCI HVC %s\n",
+	    type == kPERestartCPU ? "SYSTEM_RESET" : "SYSTEM_OFF");
+	register uint64_t functionID __asm__("x0") =
+	    type == kPERestartCPU ? 0x84000009ULL : 0x84000008ULL;
+	__asm__ volatile("hvc #0" : "+r"(functionID) : : "x1", "x2", "x3", "memory");
+	/* Successful PSCI SYSTEM_OFF/SYSTEM_RESET never return. */
+	IOLog("PDArmPlatformExpert: PSCI unexpectedly returned %lld\n",
+	    (long long)functionID);
+	return -1;
+}
+#endif
 
