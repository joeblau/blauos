  },
  "outputs": [
    "bin/hostname",
    "usr/bin/ls", "usr/bin/cp", "usr/bin/mv", "usr/bin/rm", "usr/bin/mkdir",
    "usr/bin/rmdir", "usr/bin/ln", "usr/bin/chmod", "usr/bin/touch", "usr/bin/stat",
    "usr/bin/du", "usr/bin/df", "usr/bin/cat", "usr/bin/head", "usr/bin/tail",
    "usr/bin/wc", "usr/bin/cut", "usr/bin/tr", "usr/bin/uniq", "usr/bin/tee",
    "usr/bin/grep", "usr/bin/sed", "usr/bin/comm", "usr/bin/paste", "usr/bin/rev",
    "usr/bin/fold", "usr/bin/expand", "usr/bin/unexpand", "usr/bin/basename",
    "usr/bin/dirname", "usr/bin/mktemp", "usr/bin/printenv", "usr/bin/env",
    "usr/bin/id", "usr/bin/whoami", "usr/bin/groups", "usr/bin/date", "usr/bin/ps"
  ],
  "isolation": "All five upstream sources (including puredarwin-vm-next for build support) must match the locked revisions; patches are explicit tracked inputs hashed into provenance. Utilities link the independent runtime, never the macOS host libraries.",
  "rebuild": {
    "clean_rebuild_verified": false,
