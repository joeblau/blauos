  "depends": ["runtime"],
  "builder": {
    "script": "scripts/vm/build_commands.py",
    "command": [
      "python3", "scripts/vm/build_commands.py",
      "--runtime-root", ".blauos/build/runtime",
      "--output", ".blauos/build/commands/run-1"
    ],
    "patches": [
