+
+static char     gBlauosNonce[65];
+static bool     gBlauosNonceParsed;
+static uint32_t gBlauosInterruptHandled;
+static bool     gBlauosInterruptEmitted;
+
+static bool
+blauosCheckpointNonce(void)
+{
+	if (!gBlauosNonceParsed) {
+		gBlauosNonceParsed = true;
+		/*
+		 * Scan the raw command line: PE_parse_boot_argn() converts a
+		 * digit-leading value to an integer even for a character
