+/*
+ * Validate a child `reg` offset/length pair against the arm-io parent window
+ * and produce the physical address. Rejects short properties, zero lengths,
+ * wrapping base+offset addition and ranges that escape the parent window when
+ * the firmware supplied a window length. Returns nonzero on success.
+ */
+int
+pe_arm_soc_reg_range(uintptr_t const *reg_prop, uint32_t prop_size,
+    vm_offset_t *phys, vm_offset_t *length)
+{
+	vm_offset_t     base, offset, size;
+
+	if (reg_prop == NULL || phys == NULL || length == NULL ||
+	    prop_size < 2 * sizeof(uintptr_t)) {
+		return 0;
+	}
+
+	base = pe_arm_get_soc_base_phys();
+	if (base == 0) {
+		return 0;
+	}
+
+	offset = (vm_offset_t)reg_prop[0];
+	size = (vm_offset_t)reg_prop[1];
+
+	if (size == 0 || offset > ~(vm_offset_t)0 - base) {
+		return 0;
+	}
+	if (gPESoCWindowSize != 0 &&
+	    (offset > gPESoCWindowSize || size > gPESoCWindowSize - offset)) {
+		return 0;
+	}
+
+	*phys = base + offset;
+	*length = size;
+	return 1;
+}
