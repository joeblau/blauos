+/*
+ * Map a UART node's register window. The reg property must carry a complete
+ * offset/length pair, survive overflow-checked addition against the arm-io
+ * parent base and stay inside the parent window when its length is known.
+ * Returns 1 and stores the mapped base on success, 0 otherwise.
+ */
+static int
+serial_map_uart_regs(DTEntry entryP, vm_offset_t *base_out)
+{
+	uintptr_t const *reg_prop;
+	uint32_t        prop_size;
+	vm_offset_t     reg_phys, reg_length;
+
+	if (SecureDTGetProperty(entryP, "reg", (void const **)&reg_prop, &prop_size) != kSuccess ||
+	    !pe_arm_soc_reg_range(reg_prop, prop_size, &reg_phys, &reg_length)) {
+		return 0;
+	}
+	*base_out = ml_io_map(reg_phys, reg_length);
+	return *base_out != 0;
+}
