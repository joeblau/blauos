+#ifndef _PUREDARWIN_PDAPPLEARMCPU_H
+#define _PUREDARWIN_PDAPPLEARMCPU_H
+
+#include "PDArmCPU.h"
+
+/*
+ * IOCPU personality for Apple SoCs (H13/T8103 profile). Unlike the virt/Pi
+ * PDArmCPU, this class connects the platform module to the kernel's SMP
+ * interfaces: processors are registered through ml_processor_register(),
+ * secondary cores are released with the documented PMGR reset/power handoff,
+ * and inter-processor signals use the H13 fast-IPI registers through
+ * ml_cpu_signal().
+ *
+ * One PDArmCPUInterruptController is shared by the whole supported CPU set so
+ * that enableCPUInterrupt() tracks every online processor before publishing
+ * IOService::cpusRunning().
+ */
+class PDAppleARMCPU : public PDArmCPU {
+	OSDeclareDefaultStructors(PDAppleARMCPU);
+
+private:
+	const ml_topology_cpu_t *fTopology = NULL;
+	bool fRegistered = false;
+	bool fInterruptEnabled = false;
+	char fName[16] = {0};
+
+	static PDArmCPUInterruptController *gSharedIC;
+
+	kern_return_t registerProcessor(void);
+	static bool mapPMGR(void);
+
+public:
+	virtual bool startCommon(void) APPLE_KEXT_OVERRIDE;
+	virtual void initCPU(bool boot) APPLE_KEXT_OVERRIDE;
+	virtual void quiesceCPU(void) APPLE_KEXT_OVERRIDE;
+	virtual kern_return_t startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr) APPLE_KEXT_OVERRIDE;
+	virtual void haltCPU(void) APPLE_KEXT_OVERRIDE;
+	virtual void signalCPU(IOCPU *target) APPLE_KEXT_OVERRIDE;
+	virtual void signalCPUDeferred(IOCPU *target) APPLE_KEXT_OVERRIDE;
+	virtual void signalCPUCancel(IOCPU *target) APPLE_KEXT_OVERRIDE;
+	virtual const OSSymbol *getCPUName(void) APPLE_KEXT_OVERRIDE;
+
+	void setTopology(const ml_topology_cpu_t *topology);
+	kern_return_t startSecondary(void);
+};
+
+#endif /* _PUREDARWIN_PDAPPLEARMCPU_H */
