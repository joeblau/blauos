+
+bool
+PDArmPlatformExpert::startBootCPU(PDArmCPU *cpu)
+{
+	/*
+	 * The virt/Pi profiles have no device-tree cpu nub to serve as the IOCPU
+	 * provider, so the boot CPU skips the ordinary IOCPU::start() path.
+	 */
+	cpu->attach(0);
+	return cpu->startCommon();
+}
