+PDArmCPU *
+PDAppleARMPlatformExpert::newBootCPU(void)
+{
+	return new PDAppleARMCPU;
+}
+
+bool
+PDAppleARMPlatformExpert::startBootCPU(PDArmCPU *cpu)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	PDAppleARMCPU *appleCPU = OSDynamicCast(PDAppleARMCPU, cpu);
+
+	if (appleCPU == NULL || topology == NULL || topology->boot_cpu == NULL) {
+		return false;
+	}
+
+	appleCPU->setTopology(topology->boot_cpu);
+
+	/*
+	 * The ADT cpu nubs are not published this early, so the platform expert
+	 * itself is the provider; this still routes the boot CPU through the
+	 * ordinary IOCPU::start() group and property setup.
+	 */
+	appleCPU->attach(this);
+	return appleCPU->start(this);
+}
+
+bool
+PDAppleARMPlatformExpert::startSecondaryCPUs(void)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+
+	if (topology == NULL || topology->cpus == NULL || topology->num_cpus == 0) {
+		IOLog("PDAppleARMPlatformExpert: no CPU topology; "
+		    "running on the boot CPU only\n");
+		return true;
+	}
+
+	for (unsigned int i = 0; i < topology->num_cpus; i++) {
+		const ml_topology_cpu_t *entry = &topology->cpus[i];
+		if (entry == topology->boot_cpu) {
+			continue;
+		}
+
+		PDAppleARMCPU *cpu = new PDAppleARMCPU;
+		if (cpu == NULL || !cpu->init()) {
+			IOLog("PDAppleARMPlatformExpert: could not create cpu%u\n",
+			    entry->cpu_id);
+			OSSafeReleaseNULL(cpu);
+			continue;
+		}
+		cpu->setTopology(entry);
+		cpu->attach(this);
+
+		kern_return_t rc = cpu->startSecondary();
+		if (rc != KERN_SUCCESS) {
+			IOLog("PDAppleARMPlatformExpert: cpu%u (cluster %u type %d) "
+			    "did not start: %d\n",
+			    entry->cpu_id, entry->cluster_id,
+			    (int)entry->cluster_type, rc);
+		}
+	}
+
+	/* Every processor has been registered and started; scheduler contract. */
+	ml_cpu_init_completed();
+	IOService::publishResource(gIOAllCPUInitializedKey, kOSBooleanTrue);
+	return true;
+}
