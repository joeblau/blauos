+++ b/src/Kernel/xnu/osfmk/arm/arm_init.c
@@ -158,6 +158,84 @@
 SECURITY_READ_ONLY_LATE(uint64_t) gDramSize;
 
 SECURITY_READ_ONLY_LATE(bool) serial_console_enabled = false;
