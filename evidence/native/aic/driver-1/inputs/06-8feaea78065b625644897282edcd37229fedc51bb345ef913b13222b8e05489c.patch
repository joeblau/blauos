@@ -5,3 +5,9 @@ target_link_libraries(libkmod PRIVATE xnu_kernel_headers AvailabilityHeaders)
 target_compile_definitions(libkmod PRIVATE TARGET_OS_OSX)
 
 # cplus_start.c and cplus_stop.c are empty, thus no libkmodc++.
+
+# Match the native platform extension's architecture and pointer-authentication ABI.
+if(PUREDARWIN_ARM64_MACHINE_CONFIG STREQUAL "T8103")
+    set_property(TARGET libkmod PROPERTY OSX_ARCHITECTURES arm64e)
+    target_compile_options(libkmod PRIVATE -mcpu=apple-a14 -mkernel -fno-stack-check)
+endif()
